{
  "name": "mcp-server-azure-functions",
  "version": "1.0.0",
  "description": "Servidor MCP remoto desplegado en Azure Functions con transporte Streamable HTTP",
  "main": "dist/functions/*.js",
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "clean": "rimraf dist",
    "prestart": "npm run clean && npm run build",
    "start": "func start",
    "dev": "npm run build && func start"
  },
  "dependencies": {
    "@azure/functions": "^4.6.0",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "rimraf": "^6.0.0",
    "typescript": "^5.7.0"
  }
}
